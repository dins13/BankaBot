# Скопируйте в .env и заполните своими значениями.
# Токен от @BotFather (обязательно).
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App для кнопки меню (необязательно).
# Только https:// и без слэша в конце, например:
# WEBAPP_URL=https://example.trycloudflare.com
# Внимание: адреса *.devtunnels.ms (туннель VS Code) не подходят —
# они показывают страницу-предупреждение, которую Telegram не проходит.
WEBAPP_URL=

# Режим разработки Mini App: 0/1.
WEBAPP_DEV_MODE=0

# Встроенный веб-сервер Mini App, который поднимается вместе с bot.py: 0/1.
WEBAPP_EMBED=1
# Адрес и порт встроенного веб-сервера.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
