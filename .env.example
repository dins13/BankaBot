# Скопируйте в .env и заполните своими значениями.
# Токен от @BotFather (обязательно).
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App для кнопки меню (необязательно).
WEBAPP_URL=

# Режим разработки Mini App: 0/1.
WEBAPP_DEV_MODE=0

# Встроенный веб-сервер Mini App, который поднимается вместе с bot.py: 0/1.
WEBAPP_EMBED=1
# Адрес и порт встроенного веб-сервера.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
